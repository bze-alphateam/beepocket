{
  "manifest_version": 3,
  "name": "BeePocket",
  "description": "Security-first wallet for the BeeZee (BZE) network.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://rest.getbze.com/*",
    "https://rpc.getbze.com/*",
    "https://explorer.getbze.com/*",
    "https://testnet.getbze.com/*",
    "https://testnet-rpc.getbze.com/*",
    "https://testnet-explorer.getbze.com/*",
    "https://getbze.com/wallet/add/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://getbze.com/wallet/add/*"],
      "js": ["addtoken.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
