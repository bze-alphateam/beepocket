{
  "name": "@bze/beepocket-connector",
  "version": "0.1.0",
  "description": "Connect dapps to the BeePocket wallet: provider types and an interchain-kit wallet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bze-alphateam/beepocket.git",
    "directory": "packages/connector"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@interchain-kit/core": "0.11.x"
  },
  "devDependencies": {
    "@interchain-kit/core": "0.11.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
